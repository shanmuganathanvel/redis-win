{
  "name": "redis-win",
  "version": "1.0.0",
  "description": "Ultra-lightweight Redis replacement for Windows with BullMQ, Lua scripting, Streams, and auto-persistence via npm/npx. Zero C++ build tools required.",
  "main": "src/server.js",
  "bin": {
    "redis-win": "bin/redis-win.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/redis-win.js",
    "test": "node --test test/**/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shanmuganathanvel/redis-win.git"
  },
  "keywords": [
    "redis",
    "redis-server",
    "windows",
    "in-memory",
    "cache",
    "resp",
    "bullmq",
    "lua",
    "streams",
    "lightweight",
    "npx"
  ],
  "author": "Shanmuganathan Palanivel",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/shanmuganathanvel/redis-win/issues"
  },
  "homepage": "https://github.com/shanmuganathanvel/redis-win#readme",
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "wasmoon": "^1.16.0"
  }
}
